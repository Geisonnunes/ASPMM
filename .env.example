# Copie este arquivo para .env e preencha com suas credenciais reais
# NUNCA commite o .env no Git — apenas este .env.example

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui

# Desenvolvimento: define como "true" localmente para pular o guard de admin
# NUNCA deixe "true" em produção
VITE_SKIP_ADMIN_GUARD=false

# ⚠️  A VITE_SUPABASE_SERVICE_KEY FOI REMOVIDA INTENCIONALMENTE
# A service key nunca deve ir ao frontend (fica visível no bundle JS)
# Ela só é usada nas Edge Functions via variável de ambiente do Supabase